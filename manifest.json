{
  "manifest_version": 3,
  "name": "AutoTyper Pro - High-Speed Keystroke Simulator",
  "version": "1.0.0",
  "description": "Mimics realistic human typing at ultra-high speed on LeetCode, Monaco, CodeMirror, Ace, and any web code editor.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AutoTyper Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/key-simulator.js",
        "content/target-picker.js",
        "content/floating-widget.js",
        "content/content-main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel"
  ],
  "commands": {
    "emergency-stop": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Emergency stop auto-typing immediately"
    },
    "toggle-floating-widget": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Toggle on-page floating AutoTyper controller"
    }
  }
}
